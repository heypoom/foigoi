main:
  steps:
    - wait_for_october_8_start:
        call: sys.sleep_until
        args:
          time: "2026-10-08T08:45:00Z"
    - start_october_8:
        call: googleapis.compute.v1.instances.start
        args:
          project: "${project_id}"
          zone: "${zone}"
          instance: "${instance_name}"
    - wait_for_october_8_stop:
        call: sys.sleep_until
        args:
          time: "2026-10-08T13:15:00Z"
    - stop_october_8:
        call: googleapis.compute.v1.instances.stop
        args:
          project: "${project_id}"
          zone: "${zone}"
          instance: "${instance_name}"
